# Copie para .env (na raiz do projeto) e preencha. Nunca faça commit do .env.

# Supabase (Project Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY= # chave service_role (só no backend)
SUPABASE_ANON_KEY=

# Token de sessão do Frotix. Gere um valor aleatório de 32+ caracteres, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Client ID "Web" do Google usado no login (o mesmo de src/config/google.js)
GOOGLE_WEB_CLIENT_ID=716901513376-tnb5fm21k2t2hlavoei6n7052m2terdk.apps.googleusercontent.com

EMAIL_CONFIRM_REDIRECT_URL=
PASSWORD_RECOVERY_REDIRECT_URL=frotix://auth/recovery
PORT=3000

# App (Expo): endereço do backend. Sem isso, o app usa o Render.
# No emulador com backend local: http://10.0.2.2:3000
EXPO_PUBLIC_API_URL=
