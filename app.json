{
  "expo": {
    "name": "Frotix",
    "slug": "frotix",
    "version": "1.0.0",
    "scheme": "frotix",
    "icon": "./assets/iconsApp/frotix-icon.png",
    "extra": {
      "googleClientId": "716901513376-tnb5fm21k2t2hlavoei6n7052m2terdk.apps.googleusercontent.com",
      "apiUrl": "https://frotix.onrender.com"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.frotix.android",
      "icon": "./assets/iconsApp/frotix-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/iconsApp/frotix-adaptive-foreground.png",
        "backgroundColor": "#061B48"
      }
    },
    "plugins": [
      [
        "expo-navigation-bar",
        {
          "backgroundColor": "#121212",
          "barStyle": "light"
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Permita que o Frotix use o Face ID para proteger suas credenciais."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permita que o Frotix use o Face ID para confirmar sua identidade."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permita que o Frotix registre a localização durante uma viagem em andamento.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      "expo-sqlite"
    ]
  }
}
