{
  "expo": {
    "name": "frotix",
    "slug": "frotix",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.frotix.android"
    },
    "plugins": [
      [
        "expo-navigation-bar",
        {
          "backgroundColor": "#121212",
          "barStyle": "light"
        }
      ],
      "@react-native-google-signin/google-signin"
    ]
  }
}